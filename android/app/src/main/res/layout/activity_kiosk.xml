<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Shown while connecting, and while the server can't be reached. -->
    <LinearLayout
        android:id="@+id/status_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101820"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/status_title"
            style="@style/KioskTitle"
            android:gravity="center" />

        <TextView
            android:id="@+id/status_address"
            style="@style/KioskBody"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/status_detail"
            style="@style/KioskBody"
            android:gravity="center"
            android:maxWidth="560dp"
            android:text="@string/retry_detail" />

        <Button
            android:id="@+id/status_change_server"
            style="@style/KioskButton"
            android:layout_marginTop="24dp"
            android:text="@string/retry_change_server" />
    </LinearLayout>

    <!-- First run, and when changing the server. D-pad focus reaches every control. -->
    <ScrollView
        android:id="@+id/setup_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101820"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingTop="32dp"
            android:paddingEnd="48dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/KioskTitle"
                android:text="@string/setup_title" />

            <TextView
                android:id="@+id/setup_status"
                style="@style/KioskBody" />

            <LinearLayout
                android:id="@+id/setup_servers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/KioskBody"
                android:layout_marginTop="24dp"
                android:text="@string/setup_address_label" />

            <EditText
                android:id="@+id/setup_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/focus_background"
                android:hint="@string/setup_address_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/focus_text"
                android:textColorHint="#8899AA"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/setup_error"
                style="@style/KioskBody"
                android:textColor="#FFB4A8"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/setup_cancel"
                    style="@style/KioskButton"
                    android:layout_marginEnd="12dp"
                    android:text="@string/setup_cancel" />

                <Button
                    android:id="@+id/setup_connect"
                    style="@style/KioskButton"
                    android:text="@string/setup_connect" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/setup_boot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/setup_boot_note"
                    style="@style/KioskBody"
                    android:text="@string/setup_boot_note" />

                <Button
                    android:id="@+id/setup_boot_button"
                    style="@style/KioskButton"
                    android:text="@string/setup_boot_button" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
